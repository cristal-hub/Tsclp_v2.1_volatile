# config.py
# Tsclp_v2.0 — конфигурация.
# ВАЖНО: проект предназначен ТОЛЬКО для песочницы (sandbox).
# Реальный торговый контур не реализован и не должен включаться.

import os
from dotenv import load_dotenv

load_dotenv()

# --- API и Telegram ---
TINKOFF_API_TOKEN = os.getenv("TINKOFF_API_TOKEN")
TELEGRAM_BOT_TOKEN = os.getenv("TELEGRAM_BOT_TOKEN")
TELEGRAM_CHAT_ID = os.getenv("TELEGRAM_CHAT_ID")
TINKOFF_ACCOUNT_ID = os.getenv("TINKOFF_ACCOUNT_ID")
# Ограничение управления Telegram: только этот user_id может отправлять команды.
# Узнать свой ID: написать @userinfobot в Telegram.
TELEGRAM_ALLOWED_USER_ID = os.getenv("TELEGRAM_ALLOWED_USER_ID")

# --- Режим ---
# Жёстко зафиксировано: только песочница.
# Изменение этого значения не включает реальный контур (он не реализован),
# но при USE_SANDBOX=False робот безопасно завершится с ошибкой.
USE_SANDBOX = True
ENABLE_TELEGRAM = True

# --- Инструменты ---
TRADING_TICKERS = ["SBER", "GAZP"]

# --- Риск ---
RISK_PER_TRADE = 0.01
MIN_STOP_LOSS_PERCENT = 0.005
STOP_LOSS_PERCENT = 0.012
TAKE_PROFIT_RATIO = 2.0
ATR_STOP_MULTIPLIER = 1.5
ATR_PERIOD_INTRADAY = 20
MAX_ATR_STOP_PERCENT = 0.03
MAX_POSITION_SHARE_PER_INSTRUMENT = 0.2
MAX_TOTAL_EXPOSURE = 0.6
MAX_TRADES_PER_INSTRUMENT_PER_DAY = 5

# Режим комиссии: "INVESTOR" (0.3%) или "TRADER" (0.05%, модель, требует подтверждения)
COMMISSION_MODE = "INVESTOR"
COMMISSION_PER_SIDE = 0.003 if COMMISSION_MODE == "INVESTOR" else 0.0005
SLIPPAGE_PERCENT = 0.0005  # 0.05% консервативно; 0.0001 = 0.01% оптимистично

# --- Стратегия ---
ADX_TREND_THRESHOLD = 25
ADX_PERIOD = 14
ADX_HYSTERESIS_CANDLES = 2
MIN_CANDLES_FOR_SIGNAL = 60

VOLUME_CONFIRMATION_WINDOW = 20
VOLUME_SPIKE_FACTOR = 1.5

MA_FAST_PERIOD = 9
MA_SLOW_PERIOD = 21
TREND_FILTER_MA_PERIOD = 100

BB_PERIOD = 20
BB_STD_DEV = 2
RSI_PERIOD = 14
RSI_OVERBOUGHT = 70
RSI_OVERSOLD = 30

# --- API ---
API_RETRY_COUNT = 3
API_RETRY_DELAY_SECONDS = 5
API_REQUEST_TIMEOUT_SECONDS = 10
API_CALL_DELAY_SECONDS = 0.05

# --- Тайминги ---
TRADING_CYCLE_SECONDS = 30
CANDLES_LOOKBACK_DAYS = 2

# --- Отчётность ---
# Обязательно задайте в .env. Без этого check_sandbox.py не запустится.
STARTING_BALANCE = os.getenv("STARTING_BALANCE")  # строка, преобразуется в float в check_sandbox.py


def validate():
    """Проверяет обязательные настройки. Вызывается при старте main.py и диагностики."""
    missing = []
    if not TINKOFF_API_TOKEN:
        missing.append("TINKOFF_API_TOKEN")
    if ENABLE_TELEGRAM:
        if not TELEGRAM_BOT_TOKEN:
            missing.append("TELEGRAM_BOT_TOKEN")
        if not TELEGRAM_CHAT_ID:
            missing.append("TELEGRAM_CHAT_ID")
        if not TELEGRAM_ALLOWED_USER_ID:
            missing.append("TELEGRAM_ALLOWED_USER_ID")
    if missing:
        raise RuntimeError(
            "Не заданы обязательные переменные окружения: " + ", ".join(missing) +
            ". Скопируйте .env.example в .env и заполните."
        )
    if not USE_SANDBOX:
        raise RuntimeError(
            "USE_SANDBOX=False. Реальный торговый контур в Tsclp_v2.0 не реализован. "
            "Проект предназначен только для песочницы. Установите USE_SANDBOX=True."
        )